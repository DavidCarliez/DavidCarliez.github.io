---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";
import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}
const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate } = post.data;
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
---

<BaseLayout
	meta={{
		articleDate: (updatedDate ?? publishDate).toISOString(),
		description,
		ogImage: ogImage ?? "/social-card.png",
		title,
	}}
>
	<article class="article-layout" data-pagefind-body>
		<div id="blog-hero" class="article-head">
			<Masthead content={post} readingTime={readingTime} />
		</div>
		<TOC headings={headings} tags={post.data.tags} />
		<div class="prose article-body"><slot /><WebMentions /></div>
	</article>
	<a class="back-top" href="#blog-hero" aria-label="Back to article title" hidden>↑</a>
</BaseLayout>
<script>
	const body = document.querySelector<HTMLElement>(".article-body");
	const article = document.querySelector<HTMLElement>(".article-layout");
	const progress = document.querySelector<HTMLElement>(".reading-progress");
	const topLink = document.querySelector<HTMLAnchorElement>(".back-top");
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".article-toc a")];
	const entries = links
		.map((link) => ({
			link,
			heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
		}))
		.filter((entry) => entry.heading);
	const toc = document.querySelector<HTMLDetailsElement>(".article-toc");
	const narrow = matchMedia("(max-width: 1050px)");
	const setToc = () => {
		if (toc) toc.open = !narrow.matches;
	};
	setToc();
	narrow.addEventListener("change", setToc);
	let scheduled = false;
	function update() {
		scheduled = false;
		if (!article || !body) return;
		const start = article.offsetTop - 100;
		const end = body.getBoundingClientRect().bottom + scrollY - innerHeight;
		const ratio = Math.max(0, Math.min(1, (scrollY - start) / Math.max(1, end - start)));
		if (progress) progress.style.transform = `scaleX(${ratio})`;
		if (topLink) topLink.hidden = scrollY < 550;
		let active = entries[0];
		for (const entry of entries) {
			if (entry.heading && entry.heading.getBoundingClientRect().top <= 150) active = entry;
		}
		if (ratio >= 1 && entries.length) active = entries[entries.length - 1];
		for (const entry of entries) {
			if (entry === active) entry.link.setAttribute("aria-current", "location");
			else entry.link.removeAttribute("aria-current");
		}
	}
	const requestUpdate = () => {
		if (!scheduled) {
			scheduled = true;
			requestAnimationFrame(update);
		}
	};
	addEventListener("scroll", requestUpdate, { passive: true });
	addEventListener("resize", requestUpdate);
	if (body) new ResizeObserver(requestUpdate).observe(body);
	update();
</script>
