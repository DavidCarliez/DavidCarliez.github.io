<button class="theme-button" type="button" aria-label="Switch to light theme">
	<svg
		class="theme-sun"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"
		><circle cx="12" cy="12" r="4"></circle><path
			d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path></svg
	>
	<svg
		class="theme-moon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"></path></svg
	>
</button>
<script>
	const button = document.querySelector<HTMLButtonElement>(".theme-button");
	function updateLabel() {
		const label = `Switch to ${document.documentElement.dataset.theme === "dark" ? "light" : "dark"} theme`;
		button?.setAttribute("aria-label", label);
		if (button) button.title = label;
	}
	button?.addEventListener("click", () =>
		document.dispatchEvent(
			new CustomEvent("theme-change", {
				detail: { theme: document.documentElement.dataset.theme === "dark" ? "light" : "dark" },
			}),
		),
	);
	document.addEventListener("theme-applied", updateLabel);
	updateLabel();
</script>
