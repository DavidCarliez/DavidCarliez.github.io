---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
	tags: string[];
}
const toc = generateToc(Astro.props.headings);
---

<details class="article-toc" open>
	<summary>On this page</summary>
	<nav aria-label="Table of contents">
		<ol>{toc.map((heading) => <TOCHeading heading={heading} />)}</ol>
	</nav>
	<div class="sidebar-tags" aria-label="Post topics">
		{
			Astro.props.tags.map((tag) => (
				<span data-pagefind-filter={`tag:${tag}`}>#{tag.replace(/\s+/g, "-")}</span>
			))
		}
	</div>
</details>
