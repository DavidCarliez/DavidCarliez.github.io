---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}
const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class:list={["toc-item", { "toc-child": depth > 2 }]}>
	<a href={`#${slug}`}>{text}</a>
	{
		children.length > 0 && (
			<ol>
				{children.map((heading) => (
					<Astro.self heading={heading} />
				))}
			</ol>
		)
	}
</li>
