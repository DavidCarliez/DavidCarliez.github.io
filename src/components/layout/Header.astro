---
import BrandMark from "@/components/BrandMark.astro";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length) || "/";
---

<header class="site-header" id="main-header">
	<div class="site-container header-inner">
		<a class="brand" href={`${base}/`} aria-label={`${siteConfig.title}, home`}
			><BrandMark /><span class="brand-copy"
				><span>{siteConfig.title}</span><span class="brand-description"
					>Offensive security <span aria-hidden="true">·</span> AI research</span
				></span
			></a
		>
		<nav class="primary-nav" aria-label="Main navigation">
			{
				menuLinks.map((link) => (
					<a
						href={`${base}${link.path}`}
						aria-current={
							(link.path === "/" ? path === "/" : path.startsWith(link.path)) ? "page" : undefined
						}
					>
						{link.title}
					</a>
				))
			}
		</nav>
		<div class="header-tools"><Search /><ThemeToggle /></div>
	</div>
	<div class="reading-progress" aria-hidden="true"></div>
</header>
