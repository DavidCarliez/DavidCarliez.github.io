		<span>© {new Date().getFullYear()} {siteConfig.author}</span>
		<span class="footer-note">Independent security research</span>
		<div>
			<a href="https://github.com/DavidCarliez" rel="me">GitHub</a><a href={`${base}/rss.xml`}
				>RSS</a
			><a href="#main">Back to top ↑</a>
		</div>
	</div>
</footer>
