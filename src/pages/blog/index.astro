---
import PostList from "@/components/PostList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const posts = (await getAllPosts()).sort(collectionDateSort);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<PageLayout
	meta={{ title: "Blog", description: "Security research and technical posts by David Carliez." }}
>
	<div class="archive-heading">
		<div><p class="eyebrow">Research journal</p><h1 class="title">Blog</h1></div><a
			href={`${base}/rss.xml`}>Subscribe via RSS ↗</a>
	</div>
	<PostList posts={posts} />
</PageLayout>
