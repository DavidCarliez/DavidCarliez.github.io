---
import PostList from "@/components/PostList.astro";
import ShellBar from "@/components/ShellBar.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const posts = (await getAllPosts()).sort(collectionDateSort).slice(0, 5);

const meta = {
	description:
		"Just another Freelance Offensive Security Professional. The posts in this blog are snippets of my work that can be shared publicly.",
	title: "Home",
};
---

<PageLayout meta={meta} showShell={false}>
	<section class="editorial-intro" aria-labelledby="intro-title">
		<ShellBar />
		<h1 id="intro-title">Security research, from the inside out.</h1>
		<p>Vulnerability research, offensive security, and the boundaries of AI tools.</p>
	</section>
	<section>
		<div class="section-heading">
			<h2>Latest research</h2><div class="section-links">
				<a href={`${base}rss.xml`}>Subscribe via RSS</a><a href={`${base}blog/`}>All posts ↗</a>
			</div>
		</div>
		<PostList posts={posts} highlightLatest />
	</section>
</PageLayout>
