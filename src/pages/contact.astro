---
import PageLayout from "@/layouts/Base.astro";
import publicKey from "../../public/public-key.asc?raw";

const fingerprint = "F0FD94832F7079158CA24B46AB567E8959A15286";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const meta = {
	description: "Contact David Carliez",
	title: "Contact me",
};
---

<PageLayout meta={meta}>
	<div class="about-content">
		<p class="eyebrow">Get in touch</p><h1 class="title mb-12">Contact me</h1>
		<div class="prose prose-sm prose-cactus max-w-none">
			<p>
				Email: <a class="cactus-link" href="mailto:david.carliez.consulting@gmail.com"
					>david.carliez.consulting@gmail.com</a
				>
			</p>
			<h2>PGP public key</h2>
			<div class="pgp-identity not-prose">
				<span class="fingerprint-label">Primary key fingerprint</span>
				<span class="pgp-fingerprint">{fingerprint.match(/.{4}/g)?.join(" ")}</span>
				<div class="pgp-actions">
					<button type="button" data-copy-fingerprint={fingerprint}>Copy fingerprint</button><a
						href={`${base}/public-key.asc`}
						download="david-carliez-public-key.asc">Download .asc ↓</a>
				</div>
			</div>
			<div class="pgp-panel">
				<div class="pgp-toolbar not-prose">
					<span>public-key.asc</span>
					<div>
						<button type="button" data-pgp-copy>Copy key</button>
					</div>
				</div>
				<pre
					class="pgp-key"
					aria-label="PGP public key"><code class="pgp-source">{publicKey.trimEnd()}</code></pre>
			</div>
			<p class="pgp-feedback not-prose" role="status" data-pgp-feedback></p>
		</div>
	</div>
</PageLayout>

<style>
	.pgp-identity {
		margin-top: 20px;
		font:
			12px/1.8 ui-monospace,
			monospace;
	}
	.fingerprint-label {
		display: block;
		color: var(--color-muted);
		font-size: 11px;
		margin-bottom: 6px;
	}
	.pgp-fingerprint {
		display: block;
		color: var(--color-global-text);
		overflow-wrap: anywhere;
	}
	.pgp-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 20px;
		margin-top: 10px;
		color: var(--color-accent);
	}
	.pgp-panel {
		width: fit-content;
		max-width: 100%;
	}
	.pgp-toolbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 11px 16px;
		margin-top: 24px;
		border: 1px solid var(--line);
		border-bottom: 0;
		border-radius: 6px 6px 0 0;
		background: var(--panel);
		color: var(--color-muted);
		font:
			11px/1.6 ui-monospace,
			monospace;
	}
	.pgp-toolbar div {
		display: flex;
		gap: 16px;
	}
	.pgp-toolbar button {
		color: var(--color-accent);
		padding: 3px 0;
	}
	.pgp-toolbar button:disabled {
		color: var(--color-muted);
		cursor: default;
	}
	.prose .pgp-key {
		position: relative;
		display: grid;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		margin-top: 0;
		margin-bottom: 0;
		border-radius: 0 0 6px 6px;
	}
	.prose .pgp-key > .pgp-source,
	.prose .pgp-key > :global(.pgp-effect) {
		display: block;
		grid-area: 1 / 1;
		min-width: max-content;
		width: max-content;
		font: inherit;
		font-weight: 400;
		letter-spacing: normal;
		white-space: pre;
		margin: 0;
		padding: 0;
	}
	.pgp-key.decoding .pgp-source {
		opacity: 0;
	}
	.pgp-key :global(.pgp-effect) {
		color: var(--color-accent);
		pointer-events: none;
		user-select: none;
	}
	.pgp-feedback {
		min-height: 22px;
		margin-top: 7px;
		font-size: 12px;
		color: var(--color-muted);
	}
	@media (max-width: 400px) {
		.pgp-toolbar {
			padding: 10px 12px;
			font-size: 10px;
		}
		.pgp-toolbar div {
			gap: 10px;
		}
	}
</style>

<script>
	const fingerprintButton = document.querySelector<HTMLButtonElement>("[data-copy-fingerprint]");
	fingerprintButton?.addEventListener("click", async () => {
		const status = document.querySelector<HTMLElement>("[data-pgp-feedback]");
		try {
			await navigator.clipboard.writeText(fingerprintButton.dataset.copyFingerprint || "");
			if (status) status.textContent = "Fingerprint copied.";
		} catch {
			if (status) status.textContent = "Select the fingerprint and copy it with your keyboard.";
		}
	});
	const block = document.querySelector<HTMLElement>(".pgp-key");
	const source = document.querySelector<HTMLElement>(".pgp-source");
	const copy = document.querySelector<HTMLButtonElement>("[data-pgp-copy]");
	const feedback = document.querySelector<HTMLElement>("[data-pgp-feedback]");
	if (block && source && copy && feedback) {
		const original = source.textContent || "";
		const reduced = matchMedia("(prefers-reduced-motion: reduce)");
		const glyphs = "0123456789ABCDEF:+=/\\<>[]{}";
		let timer: ReturnType<typeof setTimeout> | undefined;
		let overlay: HTMLSpanElement | undefined;
		function finish() {
			clearTimeout(timer);
			overlay?.remove();
			overlay = undefined;
			block?.classList.remove("decoding");
		}
		function reveal() {
			finish();
			if (reduced.matches || !block) return;
			overlay = document.createElement("span");
			overlay.className = "pgp-effect";
			overlay.setAttribute("aria-hidden", "true");
			block.append(overlay);
			block.classList.add("decoding");
			const start = performance.now();
			const begin = original.indexOf("\n\n") + 2;
			const end = original.indexOf("-----END");
			const settleAt = Array.from(
				original,
				(_, i) => 0.12 + 0.7 * Math.max(0, (i - begin) / (end - begin)) + Math.random() * 0.18,
			);
			function tick() {
				const progress = (performance.now() - start) / 1700;
				if (progress >= 1 || !overlay || document.hidden || reduced.matches) {
					finish();
					return;
				}
				overlay.textContent = Array.from(original, (char, i) => {
					if (i < begin || i >= end || /\s/.test(char) || progress >= (settleAt[i] ?? 0))
						return char;
					return glyphs[Math.floor(Math.random() * glyphs.length)];
				}).join("");
				timer = setTimeout(tick, 55);
			}
			tick();
		}
		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					observer.disconnect();
					reveal();
				}
			},
			{ threshold: 0.15 },
		);
		observer.observe(block);
		// Selecting or copying always exposes the unchanged, original text immediately.
		block.addEventListener("pointerdown", () => {
			observer.disconnect();
			finish();
		});
		block.addEventListener("focusin", finish);
		document.addEventListener("copy", finish, { capture: true });
		document.addEventListener("keydown", (event) => {
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "a") {
				observer.disconnect();
				finish();
			}
		});
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) finish();
		});
		function respectMotion() {
			if (reduced.matches) finish();
		}
		reduced.addEventListener("change", respectMotion);
		respectMotion();
		copy.addEventListener("click", async () => {
			observer.disconnect();
			finish();
			try {
				await navigator.clipboard.writeText(original);
				feedback.textContent = "Public key copied.";
			} catch {
				feedback.textContent = "Select the key text and copy it with your keyboard.";
			}
		});
	}
</script>
